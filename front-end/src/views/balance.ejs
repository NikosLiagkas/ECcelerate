<%- include("partials/header", { title: "Balance" }) %>

<section class="wrapper">
  <h1 class="page-title">Your Balance</h1>

  <div class="grid grid-auto grid-center">
    <div class="card card-center">
      <h3>Current Balance</h3>
      <p class="stat-value">€ 25.00</p>
    </div>

    <div class="card card-center">
      <h3>Credit Points</h3>
      <p class="stat-value">120 pts</p>
    </div>
  </div>

  <div class="card card-medium card-center">
    <h3>Add Money</h3>
    <p>You can load money to your account balance.</p>

    <form class="form">
      <label>Amount (€)</label>
      <input type="number" min="5" step="5" placeholder="e.g. 20" />

      <div class="actions-center">
        <button type="button" class="btn btn-primary">Add Money</button>
      </div>
    </form>
  </div>

  <div class="card card-wide card-table">
    <h3>Recent Payments</h3>

    <table class="table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Charge ID</th>
          <th>Amount (€)</th>
          <th>Points Used</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>2026-01-12 18:45</td>
          <td>42</td>
          <td>-5.00</td>
          <td>10</td>
        </tr>
        <tr>
          <td>2026-01-10 21:10</td>
          <td>39</td>
          <td>-7.50</td>
          <td>0</td>
        </tr>
      </tbody>
    </table>

    <div class="actions-center">
      <a href="/balance/history" class="btn btn-outline">
        Show Full Payment History
      </a>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
