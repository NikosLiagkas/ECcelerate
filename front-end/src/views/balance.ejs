<%- include("partials/header", { title: "Balance" }) %>

<section class="balance-wrapper">

  <h1 class="page-title">Your Balance</h1>

  <!-- BALANCE CARDS -->
  <div class="balance-cards">
    <div class="card balance-card">
      <h3>Current Balance</h3>
      <p class="balance-amount">€ 25.00</p>
    </div>

    <div class="card balance-card">
      <h3>Credit Points</h3>
      <p class="balance-amount">120 pts</p>
    </div>
  </div>

  <!-- ACTIONS -->
  <div class="add-money-wrapper">
    <div class="card add-money-card">
      <h3>Add Money</h3>
      <p>You can load money to your account balance.</p>
  
      <form class="add-money-form">
        <label>
          Amount (€)
          <input type="number" min="5" step="5" placeholder="e.g. 20" />
        </label>
  
        <button type="button" class="btn btn-primary">
          Add Money
        </button>
      </form>
    </div>
  </div>

    <!-- RECENT PAYMENTS -->
    <div class="card transactions-card">
        <h3>Recent Payments</h3>
    
        <table class="transactions-table">
        <thead>
            <tr>
            <th>Date</th>
            <th>Charge ID</th>
            <th>Amount (€)</th>
            <th>Points Used</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td>2026-01-12 18:45</td>
            <td>42</td>
            <td>-5.00</td>
            <td>10</td>
            </tr>
            <tr>
            <td>2026-01-10 21:10</td>
            <td>39</td>
            <td>-7.50</td>
            <td>0</td>
            </tr>
            <tr>
            <td>2026-01-08 09:30</td>
            <td>35</td>
            <td>-6.20</td>
            <td>5</td>
            </tr>
        </tbody>
        </table>
    
        <div class="transactions-actions">
        <a href="/balance/history" class="btn btn-outline">
            Show Full Payment History
        </a>
        </div>
    </div>
    
    </section>

<%- include("partials/footer") %>